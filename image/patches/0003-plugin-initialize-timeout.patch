+/**
+ * Resolve the default timeout for the initialize RPC call.
+ *
+ * 15 seconds, unless PAPERCLIP_PLUGIN_INITIALIZE_TIMEOUT_MS sets another whole
+ * number of milliseconds between 1 second and 10 minutes. Slow hosts need more:
+ * on a Raspberry Pi 4 the kubernetes sandbox provider worker spends about 10
+ * seconds of CPU importing its modules through tsx, and at boot it competes
+ * with the server for the CPU. An invalid value throws instead of falling back
+ * to 15 seconds, so a typo is not silently ignored.
+ */
+export function resolvePluginInitializeTimeoutMs(
+  env: NodeJS.ProcessEnv = process.env,
+): number {
+  const raw = env.PAPERCLIP_PLUGIN_INITIALIZE_TIMEOUT_MS?.trim();
+  if (!raw) return DEFAULT_INITIALIZE_TIMEOUT_MS;
+  const value = /^\d+$/.test(raw) ? Number(raw) : Number.NaN;
+  if (
+    !Number.isSafeInteger(value) ||
+    value < MIN_INITIALIZE_TIMEOUT_MS ||
+    value > MAX_INITIALIZE_TIMEOUT_MS
+  ) {
+    throw new Error(
+      `PAPERCLIP_PLUGIN_INITIALIZE_TIMEOUT_MS must be a whole number of milliseconds between ${MIN_INITIALIZE_TIMEOUT_MS} and ${MAX_INITIALIZE_TIMEOUT_MS}, got "${raw}"`,
+    );
+  }
+  return value;
+}
