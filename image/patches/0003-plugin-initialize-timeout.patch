+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { PaperclipPluginManifestV1 } from "@paperclipai/shared";
+
+// Mock the shared logger, as plugin-worker-manager.test.ts does: a failed
+// initialize logs an error, and it does not belong in the test output.
+vi.mock("../middleware/logger.js", () => {
+  const mockLogger: Record<string, unknown> = {
+    trace: vi.fn(),
+    debug: vi.fn(),
+    info: vi.fn(),
+    warn: vi.fn(),
+    error: vi.fn(),
+    fatal: vi.fn(),
+    child: vi.fn(() => mockLogger),
+  };
+  return { logger: mockLogger, httpLogger: vi.fn() };
+});
+
+import {
+  createPluginWorkerHandle,
+  resolvePluginInitializeTimeoutMs,
+} from "../services/plugin-worker-manager.js";
+
+const FIXTURES_DIR = path.join(path.dirname(fileURLToPath(import.meta.url)), "fixtures");
+const SLOW_INITIALIZE_WORKER_ENTRYPOINT = path.join(
+  FIXTURES_DIR,
+  "plugin-worker-slow-initialize.cjs",
+);
+
+const TEST_MANIFEST: PaperclipPluginManifestV1 = {
+  id: "test.plugin",
+  apiVersion: 1,
+  version: "1.0.0",
+  displayName: "Test plugin",
+  description: "Test plugin",
+  author: "Paperclip",
+  categories: ["automation"],
+  capabilities: [],
+  entrypoints: { worker: "dist/worker.js" },
+};
+
+function makeSlowInitializeHandle(initializeDelayMs: number, extra?: Record<string, unknown>) {
+  return createPluginWorkerHandle("test.plugin", {
+    entrypointPath: SLOW_INITIALIZE_WORKER_ENTRYPOINT,
+    manifest: TEST_MANIFEST,
+    config: {},
+    instanceInfo: {
+      instanceId: "instance-1",
+      hostVersion: "1.0.0",
+    },
+    apiVersion: 1,
+    hostHandlers: {},
+    autoRestart: false,
+    env: { SLOW_INITIALIZE_DELAY_MS: String(initializeDelayMs) },
+    ...extra,
+  });
+}
+
+afterEach(() => {
+  vi.unstubAllEnvs();
+});
+
+describe("resolvePluginInitializeTimeoutMs", () => {
+  it("uses 15 seconds when PAPERCLIP_PLUGIN_INITIALIZE_TIMEOUT_MS is unset or blank", () => {
+    expect(resolvePluginInitializeTimeoutMs({})).toBe(15_000);
+    expect(resolvePluginInitializeTimeoutMs({ PAPERCLIP_PLUGIN_INITIALIZE_TIMEOUT_MS: "" })).toBe(15_000);
+    expect(resolvePluginInitializeTimeoutMs({ PAPERCLIP_PLUGIN_INITIALIZE_TIMEOUT_MS: "   " })).toBe(15_000);
+  });
+
+  it("reads a whole number of milliseconds between 1 second and 10 minutes", () => {
+    expect(resolvePluginInitializeTimeoutMs({ PAPERCLIP_PLUGIN_INITIALIZE_TIMEOUT_MS: "60000" })).toBe(60_000);
+    expect(resolvePluginInitializeTimeoutMs({ PAPERCLIP_PLUGIN_INITIALIZE_TIMEOUT_MS: " 60000 " })).toBe(60_000);
+    expect(resolvePluginInitializeTimeoutMs({ PAPERCLIP_PLUGIN_INITIALIZE_TIMEOUT_MS: "1000" })).toBe(1_000);
+    expect(resolvePluginInitializeTimeoutMs({ PAPERCLIP_PLUGIN_INITIALIZE_TIMEOUT_MS: "600000" })).toBe(600_000);
+  });
+
+  it.each(["60s", "1e4", "-5000", "12.5", "0x3e8", "999", "600001", "abc", "99999999999999999999"])(
+    "rejects %j instead of falling back to 15 seconds",
+    (raw) => {
+      expect(() =>
+        resolvePluginInitializeTimeoutMs({ PAPERCLIP_PLUGIN_INITIALIZE_TIMEOUT_MS: raw }),
+      ).toThrow(
+        /PAPERCLIP_PLUGIN_INITIALIZE_TIMEOUT_MS must be a whole number of milliseconds between 1000 and 600000/,
+      );
+    },
+  );
+
+  it("reads process.env by default", () => {
+    vi.stubEnv("PAPERCLIP_PLUGIN_INITIALIZE_TIMEOUT_MS", "45000");
+    expect(resolvePluginInitializeTimeoutMs()).toBe(45_000);
+  });
+});
+
+describe("worker initialize timeout", () => {
+  it("fails the start when initialize outlasts initializeTimeoutMs", async () => {
+    const handle = makeSlowInitializeHandle(2_000, { initializeTimeoutMs: 50 });
+    try {
+      await expect(handle.start()).rejects.toThrow('RPC call "initialize" timed out after 50ms');
+      expect(handle.status).toBe("crashed");
+    } finally {
+      await handle.stop();
+    }
+  });
+
+  it("waits for a slow initialize that fits in initializeTimeoutMs", async () => {
+    const handle = makeSlowInitializeHandle(300, { initializeTimeoutMs: 5_000 });
+    try {
+      await handle.start();
+      expect(handle.status).toBe("running");
+    } finally {
+      await handle.stop();
+    }
+  });
+
+  it("takes the timeout from PAPERCLIP_PLUGIN_INITIALIZE_TIMEOUT_MS when the handle sets none", async () => {
+    vi.stubEnv("PAPERCLIP_PLUGIN_INITIALIZE_TIMEOUT_MS", "1000");
+    const handle = makeSlowInitializeHandle(5_000);
+    try {
+      await expect(handle.start()).rejects.toThrow('RPC call "initialize" timed out after 1000ms');
+    } finally {
+      await handle.stop();
+    }
+  });
+
+  it("does not spawn a worker when PAPERCLIP_PLUGIN_INITIALIZE_TIMEOUT_MS is invalid", async () => {
+    vi.stubEnv("PAPERCLIP_PLUGIN_INITIALIZE_TIMEOUT_MS", "15s");
+    const handle = makeSlowInitializeHandle(0);
+    try {
+      await expect(handle.start()).rejects.toThrow(/PAPERCLIP_PLUGIN_INITIALIZE_TIMEOUT_MS must be/);
+      expect(handle.status).toBe("stopped");
+    } finally {
+      await handle.stop();
+    }
+  });
+});
