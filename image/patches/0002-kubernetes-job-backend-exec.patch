+import { describe, it, expect, vi, beforeEach } from "vitest";
+
+// Alebrije patch 0002: onEnvironmentExecute on the job backend. Upstream ignored
+// command/args/stdin there and only waited for the Job's one-shot entrypoint, so
+// the server's per-run Git probe (`sh -c <probe>`) always got exit 1. The Job's
+// pod now idles and takes the same exec as the Sandbox pod.
+
+// Mock the kube-client module so the plugin handlers run against injected fake
+// API clients (as in plugin-lease-lifecycle.test.ts), and execInPod so no
+// WebSocket is opened. wrapCommandWithEnv stays real.
+const h = vi.hoisted(() => ({ clients: {} as Record<string, unknown> }));
+
+vi.mock("../../src/kube-client.js", () => ({
+  createKubeConfig: vi.fn(() => ({})),
+  makeKubeClients: vi.fn(() => h.clients),
+}));
+
+vi.mock("../../src/pod-exec.js", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("../../src/pod-exec.js")>()),
+  execInPod: vi.fn(),
+}));
+
+import plugin from "../../src/plugin.js";
+import { execInPod } from "../../src/pod-exec.js";
+
+const CONFIG = { inCluster: true, backend: "job" };
+
+function lease(providerLeaseId: string, overrides: Record<string, unknown> = {}) {
+  return {
+    providerLeaseId,
+    metadata: {
+      namespace: "paperclip-acme",
+      jobName: providerLeaseId,
+      podName: null,
+      secretName: `${providerLeaseId}-env`,
+      phase: "Pending",
+      backend: "job",
+      ...overrides,
+    },
+  };
+}
+
+function runningPod(name: string) {
+  return {
+    metadata: { name },
+    status: { phase: "Running", containerStatuses: [{ name: "agent", state: { running: {} } }] },
+  };
+}
+
+function execute(providerLeaseId: string, extra: Record<string, unknown> = {}) {
+  return plugin.definition.onEnvironmentExecute!({
+    driverKey: "kubernetes",
+    companyId: "acme",
+    environmentId: "env-1",
+    config: CONFIG,
+    lease: lease(providerLeaseId),
+    command: "sh",
+    args: ["-c", "printf ok", "paperclip-git-context", "managed"],
+    timeoutMs: 15_000,
+    ...extra,
+  });
+}
+
+beforeEach(() => {
+  h.clients = {};
+  vi.mocked(execInPod).mockReset();
+});
+
+describe("onEnvironmentExecute on the job backend (Alebrije patch 0002)", () => {
+  it("waits for the Job's pod, then execs the command with its args and stdin", async () => {
+    h.clients = {
+      batch: { readNamespacedJobStatus: vi.fn().mockResolvedValue({ status: { active: 1 } }) },
+      core: { listNamespacedPod: vi.fn().mockResolvedValue({ items: [runningPod("pc-a-pod")] }) },
+    };
+    vi.mocked(execInPod).mockResolvedValue({ exitCode: 0, stdout: "ok", stderr: "" });
+
+    const result = await execute("pc-a", { stdin: "input" });
+
+    expect(execInPod).toHaveBeenCalledTimes(1);
+    const [, namespace, podName, container, command, stdin, timeoutMs] = vi.mocked(execInPod).mock.calls[0]!;
+    expect([namespace, podName, container]).toEqual(["paperclip-acme", "pc-a-pod", "agent"]);
