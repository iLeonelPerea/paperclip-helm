+export class JobPodTimeoutError extends Error {
+  constructor(namespace: string, name: string, timeoutMs: number, lastState: string) {
+    super(`The pod of Job ${namespace}/${name} was not Running within ${timeoutMs}ms (last seen: ${lastState})`);
+    this.name = "JobPodTimeoutError";
+  }
+}
+
+type JobPodView = {
+  metadata?: { name?: string; deletionTimestamp?: unknown };
+  status?: {
+    phase?: string;
+    containerStatuses?: {
+      name?: string;
+      state?: {
+        running?: unknown;
+        waiting?: { reason?: string };
+        terminated?: { exitCode?: number; reason?: string };
+      };
+    }[];
+  };
+};
+
+/**
+ * Alebrije patch 0002: the job backend idles its pod (`sleep infinity`, see
+ * pod-spec-builder) and paperclip-server execs every command into it, as with
+ * sandbox-cr. Waits until the Job's pod is Running with its `agent` container
+ * started, and returns the pod name. A finished Job or a terminated pod can
+ * never take an exec, so those fail at once instead of waiting out the timeout;
+ * a pod still waiting (image pull, the per-run Secret not created yet) is
+ * polled until the deadline.
+ */
+export async function waitForJobPodRunning(
+  clients: KubeClients,
+  namespace: string,
+  jobName: string,
+  opts: { timeoutMs: number; pollMs?: number },
+): Promise<string> {
+  const deadline = Date.now() + opts.timeoutMs;
+  const pollMs = opts.pollMs ?? 2000;
+  let lastState = "no pod yet";
+  for (;;) {
+    const job = await getJobStatus(clients, namespace, jobName);
+    if (job.phase === "Failed" || job.phase === "Succeeded") {
+      throw new Error(
+        `Job ${namespace}/${jobName} is ${job.phase}${job.reason ? ` (${job.reason})` : ""}: its pod cannot take an exec`,
+      );
+    }
+    const result = await clients.core.listNamespacedPod({
+      namespace,
+      labelSelector: `job-name=${jobName}`,
+    });
+    const pods = ((result as { items?: JobPodView[] }).items) ?? [];
+    for (const pod of pods) {
+      if (pod.metadata?.deletionTimestamp) continue;
+      const agent = pod.status?.containerStatuses?.find((c) => c.name === "agent");
+      const terminated = agent?.state?.terminated;
+      if (pod.status?.phase === "Failed" || pod.status?.phase === "Succeeded" || terminated) {
+        throw new Error(
+          `Pod ${namespace}/${pod.metadata?.name} of Job ${jobName} terminated` +
+            (terminated ? ` (exit ${terminated.exitCode ?? "?"}${terminated.reason ? `, ${terminated.reason}` : ""})` : "") +
+            ": it cannot take an exec",
+        );
+      }
+      if (pod.status?.phase === "Running" && agent?.state?.running && pod.metadata?.name) {
+        return pod.metadata.name;
+      }
+      lastState = `${pod.status?.phase ?? "unknown phase"}${agent?.state?.waiting?.reason ? `: ${agent.state.waiting.reason}` : ""}`;
+    }
+    const remaining = deadline - Date.now();
+    if (remaining <= 0) throw new JobPodTimeoutError(namespace, jobName, opts.timeoutMs, lastState);
+    await sleep(Math.min(pollMs, remaining));
+  }
+}
